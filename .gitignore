# Rendered output; the sources are the .qmd files.
*.html
*.docx
*.pdf
*_files/
.quarto/

# Keep the Word reference document and the measurement harness, which are
# sources here rather than output.
!templates/*.docx
!visual-editor-rtl/bidi-harness.html

# Rasters that scripts/rasterize_svg.py writes beside each SVG, named
# figure.svg.png. Any other PNG, a screenshot for instance, is tracked.
*.svg.png

__pycache__/
*.pyc

/.quarto/
**/*.quarto_ipynb
